<%- include('../partials/header') %>

<div class="page-header"><h1>My Activity</h1><p>Your recent topics and posts</p></div>

<div class="grid-2">
  <div class="panel glass">
    <div class="panel-header">Recent Topics</div>
    <ul class="topic-list compact">
      <% topics.forEach(function(t) { %>
        <li class="topic-item"><div><div class="topic-title"><a href="/topic/<%= t.id %>"><%= t.title %></a></div><div class="topic-meta"><%= t.category_name %></div></div></li>
      <% }); %>
    </ul>
  </div>
  <div class="panel glass">
    <div class="panel-header">Recent Posts</div>
    <ul class="activity-list">
      <% posts.forEach(function(p) { %>
        <li class="activity-item"><a href="/topic/<%= p.topic_id %>#post-<%= p.id %>"><%= p.topic_title %></a><span class="topic-meta"><%= new Date(p.created_at).toLocaleDateString('en-US') %></span></li>
      <% }); %>
    </ul>
  </div>
</div>

<%- include('../partials/footer') %>
