<%- include('../partials/header') %>

<div class="settings-layout">
  <%- include('../partials/settings-nav') %>
  <div class="settings-content">
    <div class="settings-header">
      <h1>Change Password</h1>
      <p>Use a strong password to keep your account secure</p>
    </div>
    <% if (success) { %><div class="alert alert-success toast-msg"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error toast-msg"><%= error %></div><% } %>

    <form action="/settings/password" method="POST" class="card glass settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="current_password">Current Password</label>
        <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
      </div>
      <div class="form-group">
        <label for="new_password">New Password</label>
        <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password">
        <p class="form-hint">At least 8 characters</p>
      </div>
      <div class="form-group">
        <label for="confirm_password">Confirm New Password</label>
        <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary">Change Password</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
