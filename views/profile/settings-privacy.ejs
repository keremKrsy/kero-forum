<%- include('../partials/header') %>

<div class="settings-layout">
  <%- include('../partials/settings-nav') %>
  <div class="settings-content">
    <div class="settings-header">
      <h1>Privacy & Notifications</h1>
      <p>Manage your profile visibility and notification preferences</p>
    </div>
    <% if (success) { %><div class="alert alert-success toast-msg"><%= success %></div><% } %>

    <form action="/settings/privacy" method="POST" class="card glass settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="toggle-group">
        <label class="toggle-item">
          <div>
            <strong>Public Profile</strong>
            <p class="form-hint">If disabled, only you and moderators can view it</p>
          </div>
          <input type="checkbox" name="profile_public" <%= profile.profile_public ? 'checked' : '' %>>
        </label>

        <label class="toggle-item">
          <div>
            <strong>Show Email</strong>
            <p class="form-hint">Your email address is visible on your profile</p>
          </div>
          <input type="checkbox" name="show_email" <%= profile.show_email ? 'checked' : '' %>>
        </label>

        <label class="toggle-item">
          <div>
            <strong>Reply Notifications</strong>
            <p class="form-hint">Receive notifications when someone replies to your topics</p>
          </div>
          <input type="checkbox" name="notify_replies" <%= profile.notify_replies ? 'checked' : '' %>>
        </label>

        <label class="toggle-item">
          <div>
            <strong>Mention Notifications</strong>
            <p class="form-hint">Receive notifications when you are mentioned (coming soon)</p>
          </div>
          <input type="checkbox" name="notify_mentions" <%= profile.notify_mentions ? 'checked' : '' %>>
        </label>
      </div>

      <button type="submit" class="btn btn-primary">Save</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
