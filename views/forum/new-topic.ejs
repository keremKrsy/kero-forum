<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <h1>Yeni Konu</h1>
    <p class="auth-subtitle"><%= category.name %> kategorisinde</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/category/<%= category.slug %>/new" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="title">Başlık</label>
        <input type="text" id="title" name="title" required minlength="3" maxlength="200">
      </div>
      <div class="form-group">
        <label for="content">İçerik</label>
        <textarea id="content" name="content" required minlength="10" maxlength="10000"></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;">Konuyu Oluştur</button>
    </form>
  </div>
</div>

<p style="text-align:center;margin-top:1rem;"><a href="/category/<%= category.slug %>">← Geri</a></p>

<%- include('../partials/footer') %>
