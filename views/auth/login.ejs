<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <h1>Kero-Forum Login</h1>
    <p class="auth-subtitle">Sign in to your account</p>

    <% if (msg) { %><div class="alert alert-info"><%= msg %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_]+" autocomplete="username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required minlength="6" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;">Sign In</button>
    </form>

    <p style="text-align:center;margin-top:1.25rem;color:var(--cream-muted);font-size:0.9rem;">
      Don't have an account? <a href="/auth/register">Register</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
