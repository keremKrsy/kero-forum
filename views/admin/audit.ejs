<%- include('../partials/header') %>

<div class="page-header">
  <h1>Audit Log</h1>
  <p>All admin and user actions are logged</p>
</div>

<nav class="admin-nav">
  <a href="/admin">Dashboard</a>
  <a href="/admin/users">Users</a>
  <a href="/admin/categories">Categories</a>
  <a href="/admin/audit" class="active">Audit Log</a>
  <a href="/admin/security">Security</a>
</nav>

<div class="panel">
  <div class="panel-body table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Action</th>
          <th>User</th>
          <th>Target</th>
          <th>IP</th>
          <th>Severity</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach(function(log) { %>
          <tr>
            <td><%= log.id %></td>
            <td><%= log.action %></td>
            <td><%= log.username || '—' %></td>
            <td><%= log.target_type ? log.target_type + ' #' + log.target_id : '—' %></td>
            <td><%= log.ip_address || '—' %></td>
            <td><span class="severity-<%= log.severity %>"><%= log.severity %></span></td>
            <td><%= new Date(log.created_at).toLocaleString('en-US') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
