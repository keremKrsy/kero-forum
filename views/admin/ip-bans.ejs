<%- include('../partials/header') %>

<div class="page-header"><h1>IP Bans</h1></div>
<%- include('../partials/admin-nav') %>
<% if (msg) { %><div class="alert alert-success toast-msg"><%= msg %></div><% } %>

<form action="/admin/ip-bans" method="POST" class="card glass" style="margin-bottom:1.5rem;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row">
    <div class="form-group"><label>IP Address</label><input type="text" name="ip_address" required placeholder="203.0.113.10"></div>
    <div class="form-group"><label>Reason</label><input type="text" name="reason" required minlength="3"></div>
  </div>
  <button type="submit" class="btn btn-primary">Ban IP</button>
</form>

<div class="panel glass table-wrap">
  <table>
    <thead><tr><th>IP</th><th>Reason</th><th>By</th><th>Created</th><th></th></tr></thead>
    <tbody>
      <% bans.forEach(function(b) { %>
        <tr>
          <td><%= b.ip_address %></td>
          <td><%= b.reason %></td>
          <td><%= b.banned_by_username || '—' %></td>
          <td><%= new Date(b.created_at).toLocaleString('en-US') %></td>
          <td>
            <form action="/admin/ip-bans/<%= b.id %>/delete" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
